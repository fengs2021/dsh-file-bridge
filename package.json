{
  "name": "dsh-file-bridge",
  "version": "1.0.1",
  "description": "DSH 文件收发桥：📎 附件按钮上传（图片原生预览条/文件链接）+ send_files 工具下发 + /dsh-files 静态服务 + 反引号路径一键调起侧边栏 explorer。v1.0.1 修复非图片附件上传的 HTTP 405 / 下载 401：host 端补全 /files RPC 通道（upload）+ /dsh-files 静态路由；nginx 增加 location ^~ /dsh-files/ 免认证俾文件链接可下载。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "file",
    "attachment",
    "upload",
    "download",
    "explorer",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
